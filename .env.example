# AI provider for the chatbot (server-side only: used by api/chat.ts and src/dev-server.ts).
# If none is set, the chatbot answers from its built-in responder instead of Claude.

# Option 1 (recommended): Vercel AI Gateway.
# On Vercel deployments this works with no keys (OIDC). For local dev, create a key in
# Vercel dashboard > AI Gateway > API Keys.
# AI_GATEWAY_API_KEY=your_ai_gateway_api_key
# AI_GATEWAY_MODEL=anthropic/claude-opus-5

# Option 2: AWS Bedrock
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-opus-5

# Dev Server Port (default: 3001)
DEV_SERVER_PORT=3001

# Gmail Configuration for Contact Form Emails
# To enable email functionality:
# 1. Generate a Google App Password at https://myaccount.google.com/security
# 2. Enable 2-Step Verification if needed
# 3. Go to "App passwords" and create one for Mail
# 4. Set the values below:

GMAIL_ADDRESS=Manishsondhi94@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password-here
